---
import type { OS } from "../lib/detect-os";

interface Props {
  os: OS;
}

const { os } = Astro.props;
---

{
  os === "macos" ? (
    <svg viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path d="M13.1 5.3c.2-1 1-1.8 2-1.9.1 1-.3 1.9-.9 2.5-.6.6-1.4.9-2.1.8 0-.9.4-1.8 1-2.4z" />
      <path d="M10 6.4c-2.5 0-4.5 2.2-4.5 5.3 0 3.1 1.9 6.1 3.6 6.1.7 0 1.1-.4 1.9-.4.7 0 1.1.4 1.9.4 1.4 0 2.7-2 3.4-3.7-1.9-.9-2.3-3.6-.6-4.9-.9-1.1-2.2-1.7-3.2-1.6-.5 0-1 .2-1.5.4-.5-.2-1-.6-1-.6z" />
    </svg>
  ) : os === "linux" ? (
    <svg viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true">
      <ellipse cx="10" cy="8.2" rx="3.4" ry="4.2" />
      <path d="M6.3 11.2c0 3.2 1.6 6.3 3.7 6.3s3.7-3.1 3.7-6.3c-1 1.1-2.3 1.7-3.7 1.7s-2.7-.6-3.7-1.7z" />
      <circle cx="8.6" cy="7.2" r="0.7" fill="var(--bg, #fff)" />
      <circle cx="11.4" cy="7.2" r="0.7" fill="var(--bg, #fff)" />
    </svg>
  ) : (
    <svg viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true">
      <rect x="1.5" y="1.5" width="7.5" height="7.5" />
      <rect x="11" y="1.5" width="7.5" height="7.5" />
      <rect x="1.5" y="11" width="7.5" height="7.5" />
      <rect x="11" y="11" width="7.5" height="7.5" />
    </svg>
  )
}
