---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const tutorials = await getPublishedCollection("tutorials");
  return tutorials.map((tutorial) => ({ params: { slug: tutorial.id }, props: { tutorial } }));
}

const { tutorial } = Astro.props;
const { Content } = await render(tutorial);
---

<ContentLayout title={tutorial.data.title} description={tutorial.data.description} {...siteConfig}>
  <p><strong>{formatCourseDate(tutorial.data.date)}</strong></p>
  <Content />
  <TeachingTeam teachers={tutorial.data.teachers} />
  <RelatedContent entry={tutorial} collections={graphCollections} />
</ContentLayout>
